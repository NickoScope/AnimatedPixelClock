.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

__pycache__/
nul

# Claude Code local files (plans, notes, settings) - not synced
CLAUDE.md
.claude/

# Local working notes - not committed
NEXT_SESSION.md

# Local GIF sources / converted animations - not committed
gifs/

# Local hardware/enclosure work - not committed
hardware/

# Release upload copy; the companion EXE is already tracked in win-companion/dist.
/release/*/*.exe

# luasim build products
tools/luasim/luasim
tools/luasim/font_picopixel.inc
tools/luasim/*.raw
tools/luasim/fxhost
tools/luasim/wchost
tools/luasim/.fxbuild/
# previews ARE committed - they are the only record of what an effect looks like

# Broker credentials and API keys for env:provision - never committed
provision_secrets.ini

# Market app: the local daily-history store (fetched, not typed); the samples ARE committed
**/market/store/

# Market app: the local override with the real allocation and the private wiring (privacy rule 2026-09-15:
# this fork is public); the old name too, so a stray copy cannot be committed
**/market/**/local.json
**/apps_market.local.yaml
# The market pages' own defaults for one's build (src/market/README.md) - never committed
src/market/market_local_defaults.h
tools/luasim/*.gif
tools/luasim/*.png
tools/luasim/*.raw
