#!/bin/sh
# Refuse a commit that leaves the flight board layout out of step with its
# consumers. See src/flightboard/README.md. Enable with:
#   git config core.hooksPath .githooks
# The clock style table is generated from the web UI's own option list. If the
# UI gained or lost a style and the table was not regenerated, the knob would
# walk a stale list - so regenerate and refuse the commit if anything moved.
# Compared by hash against a regenerated copy rather than with git diff: the
# file may be untracked or already staged, and neither shows up as a diff.
if git diff --cached --name-only | grep -qE '^(src/web/web_pages\.h|src/control/clock_styles\.h)$'; then
  BEFORE=$(shasum src/control/clock_styles.h 2>/dev/null | cut -d' ' -f1)
  python3 tools/clock_styles_gen.py >/dev/null || { echo "pre-commit: style generator failed"; exit 1; }
  AFTER=$(shasum src/control/clock_styles.h | cut -d' ' -f1)
  if [ "$BEFORE" != "$AFTER" ]; then
    echo "pre-commit: src/control/clock_styles.h was stale - regenerated it."
    echo "            stage it and commit again."
    exit 1
  fi
fi

if git diff --cached --name-only | grep -qE '^(src/flightboard/|tools/fb_)'; then
  python3 tools/fb_check.py || {
    echo
    echo "pre-commit: flight board layout has drifted (see above)."
    echo "            run  python3 tools/fb_sim_build.py  and stage the other repo too."
    exit 1
  }
fi

# The world clock's map and cities live in two generated copies, one for the
# Lua prototype and one for the firmware, and the cities' zones come from the
# zone table. Checked offline: regenerating needs the Natural Earth download
# and this machine's tz database.
if git diff --cached --name-only | grep -qE '^(tools/luasim/gen_(world|tz)\.py|tools/luasim/scripts/world_clock\.lua|src/worldclock/(worldmap|tzdb)\.h)$'; then
  python3 tools/luasim/gen_tz.py --check || {
    echo
    echo "pre-commit: src/worldclock/tzdb.h does not read back as gen_tz.py writes it."
    echo "            run  python3 tools/luasim/gen_tz.py  and stage the header."
    exit 1
  }
  python3 tools/luasim/gen_world.py --check || {
    echo
    echo "pre-commit: world clock map or cities have drifted."
    echo "            run  python3 tools/luasim/gen_world.py  and stage both outputs."
    exit 1
  }
fi

# The portal is served as gzip from src/web/web_assets.h, made from the raw
# strings in the web headers. The generator also holds the settings form against
# the values /api/portal fills in (web.cpp). Checked offline: it needs only these.
if git diff --cached --name-only | grep -qE '^(tools/web_assets_gen\.py|src/web/(web_pages|web_panel_page|web_panel_js|web_assets)\.h|src/web/web\.cpp)$'; then
  python3 tools/web_assets_gen.py --check || {
    echo
    echo "pre-commit: the gzipped portal has drifted from the web headers (see above)."
    echo "            run  python3 tools/web_assets_gen.py  and stage src/web/web_assets.h."
    exit 1
  }
fi

# The onboard climate sensor: its arithmetic against the SHTC3 datasheet's own
# examples, and the weather clock's drawing (design B) against the previews,
# pixel for pixel. Offline: the host compiler and the Adafruit GFX library
# PlatformIO installed.
if git diff --cached --name-only | grep -qE '^(src/climate/|tools/climate/|src/clocks/(clock_weather\.cpp|weather_layout\.h|wifi_icon\.h|clock_globals\.cpp)|src/weather/weather(_icons)?\.h)'; then
  python3 tools/climate/check_climate.py || {
    echo
    echo "pre-commit: the climate host test failed (see above)."
    exit 1
  }
  python3 tools/climate/check_weather_screen.py || {
    echo
    echo "pre-commit: the weather screen no longer draws what tools/climate/preview/ shows (see above)."
    exit 1
  }
fi

# The presence radar's rules: the contract's payload, the age at which a target
# stops being in the room, the signed mm/s the scene has to see as cm/s, and the
# smoothing that must not outlive its data. These are the numbers
# tools/luasim/presence_panel.py renders into the previews, so a change here
# that the test does not like is a change the previews no longer show. Offline:
# the host compiler and the ArduinoJson PlatformIO installed.
if git diff --cached --name-only | grep -qE '^(src/presence/|tools/presence/)'; then
  python3 tools/presence/check_presence.py || {
    echo
    echo "pre-commit: the presence host test failed (see above)."
    exit 1
  }
fi

# The Lua effects are embedded in the firmware from the scripts luasim runs.
# Checked offline, like the world map: the generator needs only the scripts.
if git diff --cached --name-only | grep -qE '^(tools/luasim/gen_effects\.py|tools/luasim/scripts/.*\.lua|src/lua/lua_effects_scripts\.h)$'; then
  python3 tools/luasim/gen_effects.py --check || {
    echo
    echo "pre-commit: the embedded Lua effects have drifted from tools/luasim/scripts/."
    echo "            run  python3 tools/luasim/gen_effects.py  and stage the header."
    exit 1
  }
fi

# The web flasher serves real binaries to real boards, and on 2026-09-21 it came
# to serve one labelled v2.5.0 while the panel ran different bytes under the
# same name. Two binaries, one version, is the defect this refuses; a published
# image merely being older than main only prints a note, because that is normal
# between a change and a release and a hook that demands a three-board build on
# every commit is a hook people switch off. Offline: hashes the tree.
if git diff --cached --name-only | grep -qE '^(src/|platformio\.ini$|.*\.csv$)'; then
  python3 tools/firmware_stamp.py --check || exit 1
fi

# What a panel should stop showing when there is no broker behind it. That
# branch cannot be exercised on the panel we have - its broker works, which is
# the other branch - so it runs against a stub serving a real panel's captured
# answers. It stays honest because this runs: the version before it named one
# of the four market pages it switched off, and switched all four off over a
# broker that was merely restarting. Offline: stdlib only.
if git diff --cached --name-only | grep -qE '^tools/agent/(bringup\.py|tests/)'; then
  python3 tools/agent/tests/test_bringup_no_ha.py || {
    echo
    echo "pre-commit: the no-Home-Assistant bring-up test failed (see above)."
    exit 1
  }
fi

# The checks an uploaded Lua script has to pass before the parser sees it. Every
# refusal case in that test is a defect this project shipped or nearly shipped -
# a bracket counter that returned true on an unterminated comment, and one that
# knew nothing of levelled long brackets. They stay fixed because this runs.
if git diff --cached --name-only | grep -qE '^(src/lua/lua_store\.(cpp|h)|tools/luasim/store_test\.(cpp|py)|tools/luasim/host/store/)'; then
  python3 tools/luasim/store_test.py || {
    echo
    echo "pre-commit: the uploaded-script checks failed (see above)."
    exit 1
  }
fi
