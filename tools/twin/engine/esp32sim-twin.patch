+      }
+    };
+  }
+  connect();
+  $('line').addEventListener('submit', (e) => { e.preventDefault(); send({ t: 'serial', line: $('lineIn').value }); $('lineIn').value = ''; });
+
+  // ---- the remote: the owner's ten learned buttons (ir_map.h slots 1..10, functions as bound on the panel)
+  const BUTTONS = [
+    { n: 5, label: 'Power', fn: 'power', code: 0xFF28D7, cls: 'accent' },
+    { n: 8, label: 'Home', fn: 'home', code: 0xFF12ED },
+    { n: 7, label: 'Carousel', fn: 'carousel', code: 0xFF19E6 },
+    { n: 1, label: '◀', fn: 'ccw', code: 0xFF708F, cls: 'round' },
+    { n: 3, label: 'OK', fn: 'ok', code: 0xFFE01F, cls: 'round accent' },
+    { n: 2, label: '▶', fn: 'cw', code: 0xFF58A7, cls: 'round' },
+    { n: 9, label: 'Bright −', fn: 'bright_down', code: 0xFF40BF },
+    { n: 4, label: 'Long', fn: 'long', code: 0xFF41BE },
+    { n: 6, label: 'Bright +', fn: 'bright_up', code: 0xFFC03F },
+    { n: 10, label: 'Play/Pause', fn: 'media_toggle', code: 0xFFC936 },
+  ];
+  const remote = $('remote');
+  for (const b of BUTTONS) {
+    const el = document.createElement('button'); el.type = 'button'; if (b.cls) el.className = b.cls;
+    el.innerHTML = `${b.label}<small>${b.n}</small>`; el.title = `button ${b.n}, NEC 0x${b.code.toString(16).toUpperCase()}`;
+    if (b.n === 10) el.style.gridColumn = '2';
+    let t0 = 0;
+    // `ir down <code>` starts the NEC message and its repeats; `ir up` stops them (panel_inputs.rs)
+    const down = (e) => { e.preventDefault(); t0 = performance.now(); el.classList.add('held'); $('irled').classList.add('tx'); send({ t: 'input', line: 'ir down 0x' + b.code.toString(16) }); };
+    const up = () => { if (!t0) return; t0 = 0; el.classList.remove('held'); $('irled').classList.remove('tx'); send({ t: 'input', line: 'ir up' }); };
+    el.addEventListener('pointerdown', down); el.addEventListener('pointerup', up); el.addEventListener('pointerleave', up); el.addEventListener('pointercancel', up);
+    remote.appendChild(el);
+  }
+
+  // ---- the knob
+  const knob = $('knob'); let angle = 0;
+  const turn = (d) => { angle += d * 18; knob.style.setProperty('--a', angle + 'deg'); send({ t: 'knob', d: String(d) }); };
+  $('ccw').addEventListener('click', () => turn(-1)); $('cw').addEventListener('click', () => turn(1));
+  let wheelAcc = 0;
+  knob.addEventListener('wheel', (e) => { e.preventDefault(); wheelAcc += e.deltaY; while (Math.abs(wheelAcc) >= 60) { turn(wheelAcc > 0 ? 1 : -1); wheelAcc -= Math.sign(wheelAcc) * 60; } }, { passive: false });
+  let dragY = null, moved = false;
+  knob.addEventListener('pointerdown', (e) => { knob.setPointerCapture(e.pointerId); dragY = e.clientY; moved = false; knob.classList.add('down'); send({ t: 'knobpress', v: '1' }); });
+  knob.addEventListener('pointermove', (e) => { if (dragY === null) return; const dy = e.clientY - dragY; if (Math.abs(dy) >= 24) { if (!moved) { moved = true; send({ t: 'knobpress', v: '0' }); knob.classList.remove('down'); } turn(dy > 0 ? 1 : -1); dragY = e.clientY; } });
+  const release = () => { if (dragY === null) return; dragY = null; knob.classList.remove('down'); if (!moved) send({ t: 'knobpress', v: '0' }); };
+  knob.addEventListener('pointerup', release); knob.addEventListener('pointercancel', release);
+  const boot = $('boot');
+  boot.addEventListener('pointerdown', (e) => { e.preventDefault(); boot.classList.add('held'); send({ t: 'input', line: 'boot down' }); });
+  const bootUp = () => { if (!boot.classList.contains('held')) return; boot.classList.remove('held'); send({ t: 'input', line: 'boot up' }); };
+  boot.addEventListener('pointerup', bootUp); boot.addEventListener('pointerleave', bootUp);
+  $('rst').addEventListener('click', () => send({ t: 'reset' }));
+  knob.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') turn(-1); else if (e.key === 'ArrowRight') turn(1); else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); send({ t: 'knobpress', v: '1' }); setTimeout(() => send({ t: 'knobpress', v: '0' }), 120); } });
+})();
+</script>
+</body>
+</html>
