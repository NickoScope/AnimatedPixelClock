+/// A segment from the guest's `sport` to the gateway's `dport`, as the guest's stack sends it.
+fn from_guest(sport: u16, dport: u16, seq: u32, ack: u32, flags: u8, data: &[u8]) -> Vec<u8> {
+    let mut seg = segment(seq, ack, flags, data);
